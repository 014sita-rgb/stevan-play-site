<Window x:Class="StevanPlayer.App.UrlWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Отвори интернет-видео" Icon="Assets/stevan.ico"
        Width="610" Height="245" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <StackPanel Margin="22"><TextBlock Text="Директна видео адреса" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="HTTP или HTTPS видео/стрим. Адреса веб странице није видео датотека." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,12" /><TextBox x:Name="UrlBox" Text="https://" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Откажи" IsCancel="True" /><Button Content="Отвори" IsDefault="True" Click="Open_Click" Style="{StaticResource AccentButton}" Margin="0" /></StackPanel></StackPanel>
</Window>
