<Window x:Class="StevanPlayer.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подешавања · СТЕВАНplejer" Icon="Assets/stevan.ico" Width="670" Height="600" MinHeight="500" MinWidth="580"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
  <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16"><TextBlock Text="Титлови који прате ваш филм." FontSize="23" FontWeight="SemiBold" /><TextBlock Text="Без API кључева. Изаберите превод са списка у плејеру." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,12">
      <CheckBox x:Name="AutoSubtitlesBox" Content="Аутоматски пронађи доступне преводе при отварању видеа" Margin="0,0,0,18" />
      <Border Background="#172B32" BorderBrush="#31645F" BorderThickness="1" CornerRadius="8" Padding="13"><StackPanel>
        <TextBlock Text="Када превод није доступан" FontSize="17" FontWeight="SemiBold" />
        <TextBlock Text="Локални модели препознају говор и преводе титл. Преузимају се једном, око 3 GB; после тога обрада ради без интернета и без налога. Потребни су 64-bit Windows и најмање 8 GB RAM-а (препоручено 16 GB). Обрада целог филма може дуго трајати, а превод треба проверити." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,7,0,12" />
        <CheckBox x:Name="LocalAiBox"><TextBlock Text="Користи локално препознавање и превод када нема употребљивог титла." TextWrapping="Wrap" /></CheckBox>
        <CheckBox x:Name="AutoSynchronizeBox" Margin="0,12,0,0"><TextBlock Text="Аутоматски усклади изабрани титл са препознатим говором (додатна локална обрада)." TextWrapping="Wrap" /></CheckBox>
        <Button x:Name="DownloadModelsButton" Content="Преузми локалне моделе (~3 GB)" Click="DownloadModels_Click" HorizontalAlignment="Left" Margin="0,16,0,8" />
        <Button x:Name="CancelModelsButton" Content="Откажи преузимање" Click="CancelModels_Click" HorizontalAlignment="Left" Visibility="Collapsed" />
        <TextBlock x:Name="ModelStatusText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" />
      </StackPanel></Border>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Откажи" IsCancel="True" /><Button x:Name="SaveButton" Content="Сачувај" IsDefault="True" Click="Save_Click" Style="{StaticResource AccentButton}" Margin="0" /></StackPanel>
  </Grid>
</Window>
