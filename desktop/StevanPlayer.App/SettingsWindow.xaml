<Window x:Class="StevanPlayer.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подешавања · СТЕВАНplejer" Icon="Assets/stevan.ico" Width="670" Height="760" MinHeight="500" MinWidth="580"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
  <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16"><TextBlock Text="Титлови који прате ваш филм." FontSize="23" FontWeight="SemiBold" /><TextBlock Text="API кључеви се чувају локално, заштићени вашим Windows налогом." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,12">
      <CheckBox x:Name="AutoSubtitlesBox" Content="Аутоматски тражи титл при отварању видеа" Margin="0,0,0,18" />
      <TextBlock Text="OpenSubtitles" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Званични API кључ је обавезан. Кориснички токен омогућава преузимања у оквиру вашег налога и квоте." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,8" />
      <Button Content="Налог, API кључ и услови сервиса ↗" HorizontalAlignment="Left" Tag="https://www.opensubtitles.com/en/consumers" Click="Link_Click" Padding="8,5" FontSize="11" Margin="0,0,0,8" />
      <TextBlock Text="API кључ" FontSize="12" Margin="0,0,0,4" /><PasswordBox x:Name="OpenSubtitlesKeyBox" />
      <TextBlock Text="Кориснички Bearer токен (ако је доступан)" FontSize="12" Margin="0,10,0,4" /><PasswordBox x:Name="OpenSubtitlesTokenBox" />
      <TextBlock Text="SubDL" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,5" /><Button Content="SubDL API и услови сервиса ↗" HorizontalAlignment="Left" Tag="https://subdl.com/api" Click="Link_Click" Padding="8,5" FontSize="11" Margin="0,0,0,8" />
      <TextBlock Text="API кључ" FontSize="12" Margin="0,0,0,4" /><PasswordBox x:Name="SubDlKeyBox" />
      <TextBlock Text="Titlovi.com" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,5" /><Button Content="Налог и услови Titlovi.com ↗" HorizontalAlignment="Left" Tag="https://titlovi.com/" Click="Link_Click" Padding="8,5" FontSize="11" Margin="0,0,0,8" />
      <TextBlock Text="Приступ преко Kodi API сервиса Titlovi.com захтева налог са потврђеним имејлом и укључен API приступ. Активација/донација обавља се на званичном сајту; сам бесплатан налог није довољан. Поштују се квоте сервиса." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,8" />
      <Button Content="Укључи Titlovi API приступ / донације ↗" HorizontalAlignment="Left" Tag="https://titlovi.com/donacije/" Click="Link_Click" Padding="8,5" FontSize="11" Margin="0,0,0,8" />
      <TextBlock Text="Корисничко име" FontSize="12" Margin="0,0,0,4" /><TextBox x:Name="TitloviUsernameBox" />
      <TextBlock Text="Лозинка" FontSize="12" Margin="0,10,0,4" /><PasswordBox x:Name="TitloviPasswordBox" />
      <Border Background="#172B32" BorderBrush="#31645F" BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,23,0,0"><StackPanel>
        <TextBlock Text="Када титл није доступан" FontSize="17" FontWeight="SemiBold" />
        <TextBlock Text="Плејер може да издвоји звук, препозна говор и преведе титл на одабрани језик. OpenAI добија аудио снимке и текст. Обрада захтева интернет, може трајати и наплаћује се преко вашег API налога. Превод и временска усклађеност могу садржати грешке." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,7,0,12" />
        <CheckBox x:Name="CloudConsentBox"><TextBlock Text="Дозвољавам слање звука и текста OpenAI-ју и аутоматску AI обраду ако претрага не пронађе титл." TextWrapping="Wrap" /></CheckBox>
        <CheckBox x:Name="AutoSynchronizeBox" Margin="0,12,0,0"><TextBlock Text="Аутоматски усклади преузети титл са препознатим говором (додатна AI обрада)." TextWrapping="Wrap" /></CheckBox>
        <Button Content="OpenAI кључ, цене и приватност ↗" HorizontalAlignment="Left" Tag="https://platform.openai.com/api-keys" Click="Link_Click" FontSize="11" Padding="8,5" Margin="0,12,0,8" />
        <TextBlock Text="OpenAI API кључ" FontSize="12" Margin="0,0,0,4" /><PasswordBox x:Name="AiKeyBox" />
        <TextBlock Text="Модел за превођење" FontSize="12" Margin="0,10,0,4" /><TextBox x:Name="TranslationModelBox" />
      </StackPanel></Border>
      <TextBlock Text="Prijevodi-Titlovi.org и www.prijevodi-online.org отварају се ручно у прегледачу; дозвољени API приступ још није потврђен. Преузети титл можете додати дугметом Локални титл. Плејер поштује пријаву, CAPTCHA и ограничења приступа." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,18,0,0" />
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Откажи" IsCancel="True" /><Button Content="Сачувај" IsDefault="True" Click="Save_Click" Style="{StaticResource AccentButton}" Margin="0" /></StackPanel>
  </Grid>
</Window>
